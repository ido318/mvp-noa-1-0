# ─────────────────────────────────────────────────────────────
# agent/.env.example — copy to agent/.env and fill in values
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://your-ngrok-or-tunnel.example.com

# Demo mode — when true, skips external API calls in some paths
DEMO_MODE=true

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+972...
# Set false only for local testing (no tunnel)
TWILIO_VALIDATE_SIGNATURE=true

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
ELEVENLABS_WEBHOOK_SECRET=...
# Note: ELEVENLABS_TEST_IDS is NOT used here — it's only needed by app/'s
# prompt-suggestion approve route (app/.env.example), which calls ElevenLabs
# run-tests directly.

# Prompt learning loop — optional, only required for POST /jobs/analyze-conversations
# console.anthropic.com
# ANTHROPIC_API_KEY=

# Supabase (same project as app/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Supabase CLI access token (supabase.com → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=...

# Internal bearer auth
# Protects POST /jobs/process-notifications (cron/manual job runner)
JOBS_BEARER_TOKEN=replace-with-random-secret-at-least-16-chars
# Protects POST /tools/* calls from ElevenLabs ConvAI tools
TOOLS_BEARER_TOKEN=replace-with-different-random-secret-at-least-16-chars

# Clinic routing — UUID from clinics table
# Cloud (voxly ai / ssfkximqwyzqlsgwfbye): Get A Vet = 3eff0a9c-8cb3-4763-9eb9-607d254c5b05
AGENT_CLINIC_ID=...

# Cal.com (optional — for server-side calendar calls in a future phase)
# CAL_COM_API_KEY=
# CAL_COM_EVENT_TYPE_ID=
