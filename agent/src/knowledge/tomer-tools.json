[
  {
    "type": "webhook",
    "name": "lookup-customer",
    "description": "מחפש לקוח קיים לפי מספר טלפון. מחזיר שם הלקוח ושמות חיות המחמד שלו, או הודעה שהלקוח לא מוכר.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/lookup-customer",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון של המתקשר בפורמט E.164 או מקומי (למשל 054-9581991)"
          }
        },
        "required": ["phone"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "conversation-policy",
    "description": "מחזיר הנחיית שיחה קצרה בעברית: מה השלב הבא, מה לומר, ומה לשאול. השתמש כשיש בעיה רפואית לא ברורה, כשחסר הצעד הבא, או כשהשיחה מתחילה להיתקע בלופ. זה לא כלי טריאז' רפואי ולא מחליף את triage-pet-case.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/conversation-policy",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "user_utterance_he": {
            "type": "string",
            "description": "המשפט האחרון של הלקוח בעברית"
          },
          "known_pet_type": {
            "type": "string",
            "description": "סוג החיה אם כבר ידוע: כלב, חתול, או אחר"
          },
          "known_symptoms_he": {
            "type": "string",
            "description": "סיכום קצר בעברית של התסמינים שכבר נאמרו"
          },
          "known_duration_he": {
            "type": "string",
            "description": "משך הזמן אם כבר ידוע"
          },
          "red_flag_answers_he": {
            "type": "array",
            "description": "תשובות הלקוח לשאלות דגלים אדומים, אם כבר נאמרו"
          },
          "last_agent_action": {
            "type": "string",
            "description": "הפעולה האחרונה שלך, למשל ask_vomit_frequency"
          },
          "repeated_turns": {
            "type": "number",
            "description": "כמה פעמים השיחה נתקעה או חזרה על אותה נקודה"
          }
        },
        "required": ["user_utterance_he"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "triage-pet-case",
    "description": "מבצע טריאז' לתסמינים רפואיים של חיית המחמד אחרי שאספת פרטים בסיסיים ושאלת דגלי חירום רלוונטיים. השתמש בתוצאה כהחלטת בטיחות: חירום מפורש מפנים לבית חולים; ללא דגל חירום מציעים תור אצל ד\"ר נועה בשיחה טבעית.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/triage-pet-case",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "symptoms_he": {
            "type": "string",
            "description": "תיאור התסמינים בעברית כפי שתואר על ידי בעל החיה"
          },
          "pet_type": {
            "type": "string",
            "description": "סוג החיה: כלב, חתול, או אחר"
          },
          "duration_he": {
            "type": "string",
            "description": "משך הזמן שהתסמינים קיימים (למשל 'מאתמול', 'שלושה ימים')"
          },
          "pet_age_years": {
            "type": "number",
            "description": "גיל החיה בשנים"
          },
          "pet_weight_kg": {
            "type": "number",
            "description": "משקל החיה בק\"ג"
          },
          "additional_signs_he": {
            "type": "array",
            "description": "תסמינים נוספים"
          },
          "customer_id": {
            "type": "string",
            "description": "מזהה הלקוח (UUID), אופציונלי — כרגע אין כלי שמחזיר אותו; יש למלא רק אם ידוע ממקור אחר"
          },
          "pet_id": {
            "type": "string",
            "description": "מזהה החיה מ-list-customer-pets (UUID)"
          }
        },
        "required": ["symptoms_he", "pet_type"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "check-availability",
    "description": "בודק תורים פנויים לסוג ביקור מסוים בתאריך נתון. יש לקרוא לכלי זה לפני קביעת תור.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/check-availability",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "date_iso": {
            "type": "string",
            "description": "תאריך בפורמט YYYY-MM-DD (למשל 2026-06-20)"
          },
          "visit_type": {
            "type": "string",
            "description": "סוג הביקור: checkup, home_visit, vaccination, phone_consultation, neutering, consultation, urgent, follow_up, other"
          }
        },
        "required": ["date_iso", "visit_type"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "book-appointment",
    "description": "קובע תור חדש לאחר שהלקוח אישר שעה ספציפית. עיקור/סירוס ייווצר כ'ממתין לאישור' ויישלח SMS לאחר אישור ד\"ר נועה.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/book-appointment",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          },
          "customer_name": {
            "type": "string",
            "description": "שם מלא של הלקוח"
          },
          "pet_name": {
            "type": "string",
            "description": "שם חיית המחמד"
          },
          "pet_species": {
            "type": "string",
            "description": "מין החיה (כלב/חתול)"
          },
          "pet_breed": {
            "type": "string",
            "description": "גזע החיה אם הלקוח יודע, למשל לברדור, שיצו, פרסי, מעורב"
          },
          "scheduled_at": {
            "type": "string",
            "description": "תאריך ושעה בפורמט ISO8601 עם timezone (למשל 2026-06-20T10:00:00+03:00)"
          },
          "visit_type": {
            "type": "string",
            "description": "סוג הביקור: checkup, home_visit, vaccination, phone_consultation, neutering, consultation, urgent, follow_up, other"
          },
          "reason": {
            "type": "string",
            "description": "סיבת הביקור"
          }
        },
        "required": ["phone", "customer_name", "pet_name", "pet_species", "scheduled_at", "visit_type"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "cancel-or-reschedule",
    "description": "מבטל או מזיז תור קיים. ביטול פחות מ-4 שעות לפני התור מחויב במלואו.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/cancel-or-reschedule",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          },
          "action": {
            "type": "string",
            "description": "cancel לביטול, reschedule להזזה"
          },
          "current_scheduled_at": {
            "type": "string",
            "description": "תאריך ושעה של התור הקיים בפורמט ISO8601 עם timezone"
          },
          "new_scheduled_at": {
            "type": "string",
            "description": "תאריך ושעה חדשים לתור (נדרש להזזה בלבד), פורמט ISO8601 עם timezone"
          },
          "visit_type": {
            "type": "string",
            "description": "סוג הביקור: checkup, home_visit, vaccination, phone_consultation, neutering, consultation, urgent, follow_up, other"
          }
        },
        "required": ["phone", "action", "current_scheduled_at"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "join-waitlist",
    "description": "רושם לקוח לרשימת המתנה כשאין תורים פנויים. לאחר רישום — ציין שאם מצב החיה מחמיר יש לפנות לבית חולים וטרינרי.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/join-waitlist",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          },
          "customer_name": {
            "type": "string",
            "description": "שם מלא של הלקוח"
          },
          "pet_name": {
            "type": "string",
            "description": "שם חיית המחמד"
          },
          "pet_species": {
            "type": "string",
            "description": "מין החיה (כלב/חתול)"
          },
          "pet_breed": {
            "type": "string",
            "description": "גזע החיה אם הלקוח יודע, למשל לברדור, שיצו, פרסי, מעורב"
          },
          "visit_type": {
            "type": "string",
            "description": "סוג הביקור: checkup, home_visit, vaccination, phone_consultation, neutering, consultation, urgent, follow_up, other"
          },
          "preferred_start": {
            "type": "string",
            "description": "תאריך התחלה מועדף YYYY-MM-DD"
          },
          "preferred_end": {
            "type": "string",
            "description": "תאריך סיום מועדף YYYY-MM-DD"
          },
          "notes": {
            "type": "string",
            "description": "הערות נוספות"
          }
        },
        "required": ["phone", "customer_name", "pet_name", "pet_species", "visit_type"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "escalate-to-noa",
    "description": "מעביר פנייה לתשומת לב אישית של ד\"ר נועה — לענייינים לא-רפואיים בלבד (חשבונית, תלונה, שאלה שאין לה תשובה, בקשה אישית). כלי triage-pet-case מבצע escalation פנימי בעצמו; אין לקרוא לשני הכלים על אותה פנייה רפואית.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/escalate-to-noa",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "תיאור קצר של הפנייה"
          },
          "urgency": {
            "type": "number",
            "description": "רמת דחיפות מ-1 (נמוכה) עד 10 (חירום)"
          }
        },
        "required": ["reason", "urgency"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "request-human-handoff",
    "description": "מעביר את השיחה החיה לנייד של ד\"ר נועה כשהמתקשר מבקש לדבר עם אדם, או במקרה חירום. מעביר רק בשעות הפעילות; מחוץ לשעות — רושם פנייה דחופה. אם בתשובה transfer=true, בצע העברה למספר שחוזר; אם transfer=false, מסור למתקשר את הטקסט מהשדה result.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/request-human-handoff",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "תיאור קצר של סיבת הבקשה לאדם"
          },
          "emergency": {
            "type": "boolean",
            "description": "true אם מדובר במצב חירום רפואי"
          }
        },
        "required": []
      }
    }
  },
  {
    "type": "webhook",
    "name": "list-customer-pets",
    "description": "מאתר את כל חיות המחמד הרשומות ללקוח לפי מספר טלפון, ומחזיר שם, סוג ומזהה (pet_id) לכל חיה. יש לקרוא לכלי זה מיד אחרי ש-lookup-customer מזהה לקוח מוכר עם חיה אחת או יותר, כדי לקבל pet_id לשימוש בשלושת הכלים הבאים. אם יש יותר מחיה אחת, יש לשאול על איזו חיה מדובר לפני שממשיכים.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/list-customer-pets",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          }
        },
        "required": ["phone"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "get-patient-reminders",
    "description": "מחזיר תזכורות חיסון באיחור או קרובות עבור חיה ספציפית שכבר זוהתה דרך list-customer-pets. יש לקרוא לכלי זה ביוזמתך ברגע שידוע pet_id, כדי לציין חיסון שמגיע מועדו באופן טבעי במהלך השיחה.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/get-patient-reminders",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          },
          "pet_id": {
            "type": "string",
            "description": "מזהה החיה (UUID) שהתקבל מ-list-customer-pets"
          }
        },
        "required": ["phone", "pet_id"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "get-patient-chronic-conditions",
    "description": "מחזיר מצבים כרוניים רשומים עבור חיה ספציפית שכבר זוהתה דרך list-customer-pets. אם בעל החיה מדווח כרגע על החמרה בתסמינים ויש מצב כרוני רשום — יש להתייחס לכך כדגל אדום פוטנציאלי ולהמשיך דרך triage-pet-case (הכולל כבר לוגיקת אסקלציה לד\"ר נועה במידת הצורך); בכל מקרה יש להציע את התור המוקדם ביותר האפשרי. אין לפתוח נתיב הפניה חדש ואין לקרוא ל-escalate-to-noa או ל-request-human-handoff עבור זה.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/get-patient-chronic-conditions",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          },
          "pet_id": {
            "type": "string",
            "description": "מזהה החיה (UUID) שהתקבל מ-list-customer-pets"
          }
        },
        "required": ["phone", "pet_id"]
      }
    }
  },
  {
    "type": "webhook",
    "name": "get-last-visit-plan",
    "description": "מחזיר את תוכנית הטיפול/המעקב מהרשומה הרפואית המאושרת האחרונה של החיה. יש לקרוא לכלי זה כשהלקוח מזכיר 'המעקב מהפעם הקודמת' או ניסוח דומה.",
    "api_schema": {
      "url": "{{AGENT_PUBLIC_URL}}/tools/get-last-visit-plan",
      "method": "POST",
      "request_headers": {
        "Authorization": "Bearer {{AGENT_TOOLS_BEARER_TOKEN}}"
      },
      "request_body_schema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "מספר טלפון הלקוח"
          },
          "pet_id": {
            "type": "string",
            "description": "מזהה החיה (UUID) שהתקבל מ-list-customer-pets"
          }
        },
        "required": ["phone", "pet_id"]
      }
    }
  }
]
