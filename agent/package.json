{
  "name": "@mvp-noa-1-0/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Tomer — Voice AI Agent for Get A Vet (Dr. Noa Cabasheny)",
  "type": "module",
  "scripts": {
    "predev": "npm run build --prefix ../packages/shared",
    "dev": "node --env-file=.env --import tsx/esm --watch src/index.ts",
    "prebuild": "npm run build --prefix ../packages/shared",
    "build": "tsc && cp -r src/knowledge dist/knowledge",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "pretypecheck": "npm run build --prefix ../packages/shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --prefix ../packages/shared",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@supabase/supabase-js": "^2.108.1",
    "@tomer/shared": "*",
    "elevenlabs": "^1.59.0",
    "hono": "^4.6.14",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "twilio": "^5.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.61.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
