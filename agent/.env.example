# ─────────────────────────────────────────────────────────────
# agent/.env.example — copy to agent/.env and fill in values
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://your-ngrok-or-tunnel.example.com

# Demo mode — when true, skips external API calls in some paths
DEMO_MODE=true

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+972...
# Set false only for local testing (no tunnel)
TWILIO_VALIDATE_SIGNATURE=true

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
ELEVENLABS_WEBHOOK_SECRET=...

# Supabase (same project as app/)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# Clinic routing — UUID from clinics table (seed default: 00000000-0000-4000-8000-000000000001)
AGENT_CLINIC_ID=00000000-0000-4000-8000-000000000001

# Cal.com (optional — for server-side calendar calls in a future phase)
# CAL_COM_API_KEY=
# CAL_COM_EVENT_TYPE_ID=
